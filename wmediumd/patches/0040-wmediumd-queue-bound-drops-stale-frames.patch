-static void queue_frame(struct wmediumd *ctx, struct station *station,
+/*
+ * A frame that would wait longer than the queue bound for the air is dropped, as a radio's full
+ * transmit queue drops it: its status goes back unacknowledged and it is freed. Delivered
+ * seconds or minutes late it serves no one, and a queue fed faster than the air carries never
+ * drains: rdk-1009 (9 October) had 172,244 frames waiting 28 minutes after a ping overload, and
+ * every Wi-Fi backhaul stayed down. Counted in the telemetry, logged at most once a second.
+ */
+static void queue_bound_drop(struct wmediumd *ctx, struct frame *frame, u64 wait_usec)
+{
+	time_t now = time(NULL);
+
+	frame->flags &= ~HWSIM_TX_STAT_ACK;
+	if (frame->src)
+		send_tx_info_frame_nl(ctx, frame);
+	wmd_telemetry_queue_bound_drop(ctx);
+	wmd_telemetry_frame_done(ctx);
+	ctx->queue_bound_unlogged++;
+	if (now != ctx->queue_bound_logged_at) {
+		w_logf(ctx, LOG_NOTICE, "queue bound: %llu frames dropped, waiting over %llu us (this one %llu us)\n",
+		       (unsigned long long)ctx->queue_bound_unlogged,
+		       (unsigned long long)ctx->queue_bound_usec, (unsigned long long)wait_usec);
+		ctx->queue_bound_unlogged = 0;
+		ctx->queue_bound_logged_at = now;
+	}
+	if (frame->radio_queue)
+		frame->radio_queue->active_frame = NULL;    /* its next frame: schedule_next_radio_frame */
+	free(frame);
+}
+
+/* false: the frame was dropped (queue_bound_drop) and freed */
+static bool queue_frame(struct wmediumd *ctx, struct station *station,
 			struct frame *frame)
 {
