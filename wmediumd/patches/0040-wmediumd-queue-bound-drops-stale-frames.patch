+/* The queue bound (-B): offered faster than the air carries, the frames past the bound are
+ * dropped and freed, every one kept starts within it, and once the air is free a new frame
+ * goes at once (the medium recovers); with no bound every frame waits (the old queue). */
+static int queue_bound_selftest(void)
+{
+	int failures = 0;
+	uint64_t started = scheduler.current_time;
+	for (int bounded = 1; bounded >= 0; bounded--) {
+		struct wmediumd test = {0};
+		struct station stations[2] = {0};
+		struct station *pointers[] = {&stations[0], &stations[1]};
+		int matrix[] = {0, 40, 40, 0};
+		struct frame *kept[100];
+		int kept_count = 0, dropped = 0;
+		INIT_LIST_HEAD(&test.stations);
+		test.sta_array = pointers;
+		test.num_stas = 2;
+		test.snr_matrix = matrix;
+		test.get_link_snr = selftest_pair_snr;
+		test.get_error_prob = packet_test_per;
+		test.get_fading_signal = packet_test_fading;
+		test.queue_bound_usec = bounded ? 50000 : 0;
+		for (int index = 0; index < 2; index++) {
+			stations[index].index = index;
+			stations[index].addr[0] = 0x02;
+			stations[index].addr[1] = 0xed;
+			stations[index].addr[5] = index;
+			station_init_queues(&stations[index]);
+			list_add_tail(&stations[index].list, &test.stations);
+			mc_update_vif_owner(&test, &stations[index], stations[index].addr, 5180);
+		}
+		for (int n = 0; n < 101; n++) {
+			struct frame *frame = calloc(1, sizeof(*frame) + 1000);
+			if (!frame)
+				return failures + 1;
+			struct ieee80211_hdr *header = (void *)frame->data;
+			frame->sender = &stations[0];
+			frame->freq = 5180;
+			frame->data_len = 1000;
+			frame->tx_rates_count = 1;
+			frame->tx_rates[0].idx = 0;
+			frame->tx_rates[0].count = 1;
+			frame->flags |= HWSIM_TX_CTL_NO_ACK;
+			header->frame_control[0] = 0x08;
+			memcpy(header->addr1, stations[1].addr, ETH_ALEN);
+			memcpy(header->addr2, stations[0].addr, ETH_ALEN);
+			if (n == 100) {
+				/* the air free again: every kept frame sent */
+				uint64_t last = scheduler.current_time;
+				for (int k = 0; k < kept_count; k++) {
+					if (kept[k]->job.start > last)
+						last = kept[k]->job.start;
+					rf_release_frame(kept[k]);
+					list_del(&kept[k]->list);
+					usfstl_sched_del_job(&kept[k]->job);
+					free(kept[k]);
+				}
+				kept_count = 0;
+				scheduler.current_time = last + 1;
+			}
+			if (queue_frame(&test, &stations[0], frame)) {
+				failures += frame->job.start - frame->duration - scheduler.current_time >
+					    (bounded ? 50000 : (uint64_t)-1);
+				kept[kept_count++] = frame;
+			} else {
+				dropped++;
+			}
+		}
+		/* bounded: some kept, the rest dropped, the last (on a free air) kept at once */
+		failures += bounded ? (dropped == 0 || dropped >= 100) : dropped != 0;
+		failures += kept_count != 1 ||
+			    kept[0]->job.start - kept[0]->duration != scheduler.current_time;
+		for (int k = 0; k < kept_count; k++) {
+			rf_release_frame(kept[k]);
+			list_del(&kept[k]->list);
+			usfstl_sched_del_job(&kept[k]->job);
+			free(kept[k]);
+		}
+		scheduler.current_time = started;
+	}
+	printf("%s queue bound: frames past it dropped and freed, the kept ones within it, the air free again at once, unbounded without it\n",
+		failures ? "FAIL" : "PASS");
+	return failures;
+}
