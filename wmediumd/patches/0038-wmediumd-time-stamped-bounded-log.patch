From: EasyMesh labs
Subject: [PATCH] wmediumd: a time on every log line, and a bounded log

The medium's log (its drops at a receiver, netlink errors) carried no time, so
a burst of hwsim refusals could not be set beside the lab's own events, and on
a file it grew for as long as the medium ran.

stdout and stderr now go through a writer (fopencookie) that starts every line
with the UTC time to the microsecond: w_logf and every direct print alike, a
line printed in parts stamped once. It writes with write(2) on the descriptors
the daemon was started with, so no pipe or reader can block the medium. With
-L BYTES, a log on a regular file is renamed to FILE.1 (replacing the last one)
once past BYTES and continued in a new FILE, both streams in it, its first line
naming FILE.1. The help, -V and the self-test print as before.

diff --git a/wmediumd/wmediumd.c b/wmediumd/wmediumd.c
index cd142b3..4458808 100644
--- a/wmediumd/wmediumd.c
+++ b/wmediumd/wmediumd.c
@@ -22,6 +22,11 @@
  *	02110-1301, USA.
  */
 
+#define _GNU_SOURCE    /* fopencookie: the log's time stamps */
+#include <stdio.h>
+#include <time.h>
+#include <fcntl.h>
+#include <sys/stat.h>
 #include <netlink/netlink.h>
 #include <netlink/genl/genl.h>
 #include <netlink/genl/ctrl.h>
@@ -1920,6 +1925,7 @@ static void print_help(int exval)
 	printf("  -S              disable survey accounting for observer A/B tests\n");
 	printf("  -n              force netlink use even with vhost-user\n");
 	printf("  -p FILE         log packets to pcapng file FILE\n");
+	printf("  -L BYTES        a log on a file: past BYTES, renamed to FILE.1 and continued\n");
 
 	exit(exval);
 }
@@ -2775,6 +2781,125 @@ static int wmd_selftest(void)
 	return fails ? 1 : 0;
 }
 
+/*
+ * The log: every line wmediumd writes to stdout or stderr starts with the wall-clock time
+ * (UTC, microseconds), so the medium's drops and netlink errors can be set beside the lab's
+ * own events. With -L, a log that is a regular file is bounded: past that many bytes it is
+ * renamed to FILE.1 (replacing the last one) and continued in a new FILE. Both streams go
+ * through here, w_logf and every direct print alike; they are written with write(2) on the
+ * descriptors the daemon was started with, so nothing in between can block the medium.
+ */
+struct log_sink {
+	int fd;
+	bool line_start;
+};
+
+static struct log_sink log_out = { STDOUT_FILENO, true };
+static struct log_sink log_err = { STDERR_FILENO, true };
+static off_t log_max_bytes;
+
+static void log_write_all(int fd, const char *data, size_t length)
+{
+	while (length > 0) {
+		ssize_t written = write(fd, data, length);
+
+		if (written < 0) {
+			if (errno == EINTR)
+				continue;
+			return;
+		}
+		data += written;
+		length -= (size_t)written;
+	}
+}
+
+static void log_write_stamp(int fd)
+{
+	struct timespec now;
+	struct tm utc;
+	char stamp[40];
+	size_t length;
+
+	clock_gettime(CLOCK_REALTIME, &now);
+	gmtime_r(&now.tv_sec, &utc);
+	length = strftime(stamp, sizeof(stamp), "%Y-%m-%dT%H:%M:%S", &utc);
+	length += (size_t)snprintf(stamp + length, sizeof(stamp) - length, ".%06ldZ ",
+				   now.tv_nsec / 1000);
+	log_write_all(fd, stamp, length);
+}
+
+/* the log file grown past -L: renamed to FILE.1, both streams continued in a new FILE */
+static void log_rotate_if_due(void)
+{
+	struct stat out, err;
+	char link[64], path[PATH_MAX - 2], rotated[PATH_MAX];
+	ssize_t length;
+	int fd;
+
+	if (log_max_bytes <= 0 || fstat(log_out.fd, &out) != 0 || !S_ISREG(out.st_mode) ||
+	    out.st_size < log_max_bytes)
+		return;
+	snprintf(link, sizeof(link), "/proc/self/fd/%d", log_out.fd);
+	length = readlink(link, path, sizeof(path) - 1);
+	if (length <= 0)
+		return;
+	path[length] = '\0';
+	snprintf(rotated, sizeof(rotated), "%s.1", path);
+	if (rename(path, rotated) != 0)
+		return;
+	fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_APPEND, out.st_mode & 0777);
+	if (fd < 0)
+		return;
+	if (fstat(log_err.fd, &err) == 0 && err.st_dev == out.st_dev && err.st_ino == out.st_ino)
+		dup2(fd, log_err.fd);
+	dup2(fd, log_out.fd);
+	close(fd);
+	log_out.line_start = log_err.line_start = true;
+	log_write_stamp(log_out.fd);
+	dprintf(log_out.fd, "log: past %lld bytes, the lines before are in %s\n",
+		(long long)log_max_bytes, rotated);
+}
+
+static ssize_t log_cookie_write(void *cookie, const char *data, size_t size)
+{
+	struct log_sink *sink = cookie;
+	size_t done = 0;
+
+	while (done < size) {
+		const char *newline = memchr(data + done, '\n', size - done);
+		size_t chunk = newline ? (size_t)(newline - (data + done)) + 1 : size - done;
+
+		if (sink->line_start)
+			log_write_stamp(sink->fd);
+		log_write_all(sink->fd, data + done, chunk);
+		sink->line_start = newline != NULL;
+		done += chunk;
+	}
+	if (sink->line_start)
+		log_rotate_if_due();
+	return (ssize_t)size;
+}
+
+/* stdout (line-buffered) and stderr (unbuffered) through the stamping writer */
+static void log_streams_init(void)
+{
+	cookie_io_functions_t io = { .write = log_cookie_write };
+	FILE *out, *err;
+
+	fflush(stdout);
+	fflush(stderr);
+	out = fopencookie(&log_out, "w", io);
+	err = fopencookie(&log_err, "w", io);
+	if (out) {
+		setvbuf(out, NULL, _IOLBF, BUFSIZ);
+		stdout = out;
+	}
+	if (err) {
+		setvbuf(err, NULL, _IONBF, 0);
+		stderr = err;
+	}
+}
+
 int main(int argc, char *argv[])
 {
 	int opt;
@@ -2806,7 +2931,7 @@ int main(int argc, char *argv[])
 	unsigned long int parse_log_lvl;
 	char* parse_end_token;
 
-	while ((opt = getopt(argc, argv, "hVc:l:x:t:u:a:C:R:O:np:TFSQ")) != -1) {
+	while ((opt = getopt(argc, argv, "hVc:l:x:t:u:a:C:R:O:np:TFSQL:")) != -1) {
 		switch (opt) {
 		case 'Q':
 			ctx.priority_queues = true;
@@ -2873,6 +2998,13 @@ int main(int argc, char *argv[])
 		case 'p':
 			init_pcapng(&ctx, optarg);
 			break;
+		case 'L':
+			log_max_bytes = strtoll(optarg, &parse_end_token, 10);
+			if (*parse_end_token != '\0' || log_max_bytes < 0) {
+				printf("wmediumd: Error - -L takes a size in bytes: %s\n\n", optarg);
+				print_help(EXIT_FAILURE);
+			}
+			break;
 		case '?':
 			printf("wmediumd: Error - No such option: "
 			       "`%c'\n\n", optopt);
@@ -2885,6 +3017,8 @@ int main(int argc, char *argv[])
 	if (optind < argc)
 		print_help(EXIT_FAILURE);
 
+	log_streams_init();
+
 	if (!config_file) {
 		printf("%s: config file must be supplied\n", argv[0]);
 		print_help(EXIT_FAILURE);
