From: EasyMesh labs
Subject: [PATCH] wmediumd: the ACK at the control response rate

Every ACK was charged at rate index 0: on 2.4 GHz that is 1 Mbit/s, 304 us of air for a
14-byte frame that 802.11 sends at the control response rate (802.11-2016 10.6.6.5.2: the
highest rate of the eliciting frame's modulation class, not above its rate, in the basic
rate set, or the mandatory one), 28 us at 24 Mbit/s for a 54 Mbit/s frame, 44 us at
6 Mbit/s; its error probability was that of a 1 Mbit/s frame as well. On 5 GHz index 0 is
6 Mbit/s, which only overcharges the ACK of faster frames (44 us instead of 28).

The medium does not know a BSS's basic rate set, so it takes the mandatory rates: 6, 12
and 24 Mbit/s for OFDM data (an MCS rate mapped to its nearest legacy OFDM curve first, as
for the data), a CCK frame's own rate (1, 2, 5.5 and 11 Mbit/s are all mandatory for
HR/DSSS). The ACK's air time, the sender's time on the air and the ACK's error probability
all use it, per attempted rate. The self-test checks the control response rate of every
2.4 and 5 GHz data rate, and an acknowledged frame's air time and ACK error probability at
54 and 6 Mbit/s on 2.4 GHz, at 1 Mbit/s (CCK), and at 54 and 6 Mbit/s on 5 GHz.

diff --git a/wmediumd/wmediumd.c b/wmediumd/wmediumd.c
index ac940a1..c6794bb 100644
--- a/wmediumd/wmediumd.c
+++ b/wmediumd/wmediumd.c
@@ -684,6 +684,27 @@ static int model_rate_idx(int idx, uint16_t flags, u32 freq)
 	return best + (freq > 5000 ? 0 : 4);
 }
 
+/*
+ * The ACK's rate (802.11-2016 10.6.6.5.2, the control response rate): the highest rate of the
+ * eliciting frame's modulation class, not above its rate, that every station supports. The
+ * medium does not know a BSS's basic rate set, so it takes the mandatory ones: 6, 12 and
+ * 24 Mbit/s for OFDM data; a CCK frame's own rate (1, 2, 5.5 and 11 Mbit/s are all mandatory
+ * for HR/DSSS). Charged at 1 Mbit/s (rate index 0) on 2.4 GHz, every ACK there took 304 us of
+ * air instead of 28 to 44 us, and its error probability was that of a 1 Mbit/s frame.
+ * DATA_RATE_IDX and the result are model indices (index_to_rate: 5 GHz and up start at OFDM).
+ */
+static int ack_rate_idx(int data_rate_idx, u32 freq)
+{
+	int ofdm_base = freq > 5000 ? 0 : 4;
+	int ofdm = data_rate_idx - ofdm_base;
+
+	if (data_rate_idx < 0)
+		return 0;
+	if (ofdm < 0)
+		return data_rate_idx;
+	return ofdm_base + (ofdm >= 4 ? 4 : ofdm >= 2 ? 2 : 0);
+}
+
 static int frame_model_rate_idx(const struct frame *frame, int rate_slot)
 {
 	uint16_t flags = 0;
@@ -853,8 +874,8 @@ static bool queue_frame(struct wmediumd *ctx, struct station *station,
 
 	int retries = 0;
 
-	int ack_time_usec = pkt_duration(10, index_to_rate(0, frame->freq)) +
-	                    sifs;
+	/* the ACK of the attempt's rate (ack_rate_idx), SIFS included */
+	int ack_idx = 0, ack_time_usec = 0;
 
 	/*
 	 * To determine a frame's expiration time, we compute the
@@ -912,6 +933,8 @@ static bool queue_frame(struct wmediumd *ctx, struct station *station,
 		error_prob = ctx->get_error_prob(ctx, snr, per_rate_idx,
 						 frame->freq, frame->data_len,
 						 station, deststa);
+		ack_idx = ack_rate_idx(per_rate_idx, frame->freq);
+		ack_time_usec = pkt_duration(10, index_to_rate(ack_idx, frame->freq)) + sifs;
 		for (j = 0; j < frame->tx_rates[i].count; j++) {
 			int data_time = pkt_duration(frame->data_len,
 				index_to_rate(per_rate_idx, frame->freq));
@@ -947,7 +970,7 @@ static bool queue_frame(struct wmediumd *ctx, struct station *station,
 				int reverse_snr = wmd_get_link_snr(ctx, deststa, station, frame->freq) -
 					get_signal_offset_by_interference(ctx, deststa->index,
 						station->index, frame->freq) + ctx->get_fading_signal(ctx);
-				double reverse_per = ctx->get_error_prob(ctx, reverse_snr, 0,
+				double reverse_per = ctx->get_error_prob(ctx, reverse_snr, ack_idx,
 					frame->freq, 10, deststa, station);
 				frame->forward_received = true;
 				frame->rx_rate_idx = per_rate_idx;
@@ -2353,6 +2376,90 @@ static int queue_bound_selftest(void)
 	return failures;
 }
 
+static unsigned int ack_test_rate;
+
+static double ack_test_per(struct wmediumd *ctx, double snr, unsigned int rate,
+			   u32 frequency, int length, struct station *source,
+			   struct station *destination)
+{
+	if (length == 10)
+		ack_test_rate = rate;
+	return 0;
+}
+
+static int ack_rate_selftest(void)
+{
+	/* model data rate index -> its ACK's, on 2.4 GHz (CCK 0 to 3, OFDM from 4) and 5 GHz */
+	static const int ack_2g[12] = {0, 1, 2, 3, 4, 4, 6, 6, 8, 8, 8, 8};
+	static const int ack_5g[8] = {0, 0, 2, 2, 4, 4, 4, 4};
+	static const struct { u32 freq; int rate_idx, ack_usec; } frames[] = {
+		{2437, 11, 28}, {2437, 4, 44}, {2437, 0, 304}, {5180, 7, 28}, {5180, 0, 44},
+	};
+	int failures = 0;
+	uint64_t started = scheduler.current_time;
+
+	for (int idx = 0; idx < 12; idx++)
+		failures += ack_rate_idx(idx, 2437) != ack_2g[idx];
+	for (int idx = 0; idx < 8; idx++)
+		failures += ack_rate_idx(idx, 5180) != ack_5g[idx];
+	/* an acknowledged frame: the sender's air time and the ACK's error probability */
+	for (unsigned int n = 0; n < sizeof(frames) / sizeof(frames[0]); n++) {
+		struct wmediumd test = {0};
+		struct station stations[2] = {0};
+		struct station *pointers[] = {&stations[0], &stations[1]};
+		int matrix[] = {0, 40, 40, 0};
+		u32 freq = frames[n].freq;
+		int sifs = freq < 3000 ? 10 : 16, difs = 2 * 9 + sifs;
+		int rate = index_to_rate(frames[n].rate_idx, freq);
+		int expected = difs + pkt_duration(500, rate) +
+			(freq < 3000 && frames[n].rate_idx >= 4 ? 6 : 0) + sifs + frames[n].ack_usec;
+		struct frame *frame = calloc(1, sizeof(*frame) + 500);
+		struct ieee80211_hdr *header;
+
+		if (!frame)
+			return failures + 1;
+		INIT_LIST_HEAD(&test.stations);
+		test.sta_array = pointers;
+		test.num_stas = 2;
+		test.snr_matrix = matrix;
+		test.get_link_snr = selftest_pair_snr;
+		test.get_error_prob = ack_test_per;
+		test.get_fading_signal = packet_test_fading;
+		for (int index = 0; index < 2; index++) {
+			stations[index].index = index;
+			stations[index].addr[0] = 0x02;
+			stations[index].addr[1] = 0xac;
+			stations[index].addr[5] = index;
+			station_init_queues(&stations[index]);
+			list_add_tail(&stations[index].list, &test.stations);
+			mc_update_vif_owner(&test, &stations[index], stations[index].addr, freq);
+		}
+		header = (void *)frame->data;
+		frame->sender = &stations[0];
+		frame->freq = freq;
+		frame->data_len = 500;
+		frame->tx_rates_count = 1;
+		frame->tx_rates[0].idx = frames[n].rate_idx;
+		frame->tx_rates[0].count = 1;
+		header->frame_control[0] = 0x08;
+		memcpy(header->addr1, stations[1].addr, ETH_ALEN);
+		memcpy(header->addr2, stations[0].addr, ETH_ALEN);
+		ack_test_rate = 99;
+		if (!queue_frame(&test, &stations[0], frame))
+			return failures + 1;
+		failures += !(frame->flags & HWSIM_TX_STAT_ACK) || frame->duration != expected ||
+			    ack_test_rate != (unsigned int)ack_rate_idx(frames[n].rate_idx, freq);
+		rf_release_frame(frame);
+		list_del(&frame->list);
+		usfstl_sched_del_job(&frame->job);
+		free(frame);
+		scheduler.current_time = started;
+	}
+	printf("%s ACK rate: the control response rate (OFDM 6/12/24 Mbit/s, CCK its own), its air time and error probability\n",
+		failures ? "FAIL" : "PASS");
+	return failures;
+}
+
 static int spatial_queue_selftest(void)
 {
 	int failures = 0;
@@ -2645,6 +2752,7 @@ static int wmd_selftest(void)
 	printf("=== wmediumd multichannel + Linux 7 rate-flags self-test ===\n");
 	fails += packet_path_selftest();
 	fails += queue_bound_selftest();
+	fails += ack_rate_selftest();
 	fails += radio_head_selftest(false, false);
 	fails += radio_head_selftest(true, false);
 	fails += radio_head_selftest(false, true);
